# ---------------------------------------------------------------------------
# Portfolio image sync - environment template
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
#   copy .env.example .env
# ---------------------------------------------------------------------------

# Google Drive folder that holds the portfolio images.
# Take the ID from the folder URL: https://drive.google.com/drive/folders/<THIS_PART>
DRIVE_FOLDER_ID=

# --- Credentials: provide ONE of the two below -----------------------------

# Option 1 (local development): path to the downloaded service account JSON key.
# Both spellings are auto-detected, so either filename works.
GOOGLE_SERVICE_ACCOUNT_FILE=./services-account.json

# Option 2 (Vercel / CI): the ENTIRE JSON file content on a single line.
# Vercel cannot hold files, only strings, so paste the key JSON here as one line.
# PowerShell helper to produce it:
#   (Get-Content .\services-account.json -Raw) -replace "`r`n","" -replace "`n",""
# When this variable is set it takes priority over GOOGLE_SERVICE_ACCOUNT_FILE.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- OAuth scope ------------------------------------------------------------
# drive.readonly is enough for sync. Never grant drive.full unless you need writes.
DRIVE_SCOPES=https://www.googleapis.com/auth/drive.readonly

# --- Output paths (defaults match the Next.js App Router layout) ------------
OUT_DIR=./public/images
MANIFEST_PATH=./src/generated/image-manifest.json

# --- Image processing -------------------------------------------------------
# Longest edge in pixels. Set 0 to keep original resolution.
MAX_WIDTH=1920

# AVIF/WebP quality. 50-55 AVIF is visually lossless for photos at portfolio size.
AVIF_QUALITY=52
WEBP_QUALITY=78

# SVG is XML and can carry <script>, so it is a stored-XSS vector. Blocked by default.
ALLOW_SVG=false

# Delete local files whose Drive source disappeared. Set false to keep orphans.
PRUNE_ORPHANS=true

# Parallel downloads. Keep low to stay inside Drive API quota.
SYNC_CONCURRENCY=4

# Abort the whole sync (exit code 1) if any single image fails. Useful in CI.
SYNC_FAIL_ON_ERROR=false
